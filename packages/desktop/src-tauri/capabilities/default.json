{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the dashboard windows (main, main-2, ...). The About window gets none.",
  "windows": [
    "main",
    "main-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    "notification:default",
    "updater:default",
    "autostart:default"
  ]
}
